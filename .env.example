# Copy to .env.local and fill in. Never commit the real file.

# Anthropic API key for the QA agent. Only used on a real run (--confirm),
# never on a --dry-run. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Test accounts for each app, referenced by the target YAML files as ${VAR}.
# These must be throwaway accounts in a LOCAL TEST database, never real users.

# minmatside (two authors + one admin in the local test db).
# These defaults match `npm run db:seed-redteam` in the minmatside repo, so you
# can run that script and leave these as-is. Override both here AND there if you
# want different credentials.
MINMATSIDE_ADMIN_EMAIL=rt-admin@test.local
MINMATSIDE_ADMIN_PASSWORD=redteam-admin-pw
MINMATSIDE_AUTHOR_A_EMAIL=rt-author-a@test.local
MINMATSIDE_AUTHOR_A_PASSWORD=redteam-author-a-pw
MINMATSIDE_AUTHOR_B_EMAIL=rt-author-b@test.local
MINMATSIDE_AUTHOR_B_PASSWORD=redteam-author-b-pw

# bergen-maritime-leads (admin, viewer, guest in its local test db)
MARITIME_ADMIN_EMAIL=
MARITIME_ADMIN_PASSWORD=
MARITIME_VIEWER_EMAIL=
MARITIME_VIEWER_PASSWORD=
MARITIME_GUEST_EMAIL=
MARITIME_GUEST_PASSWORD=
